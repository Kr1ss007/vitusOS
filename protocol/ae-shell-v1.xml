<?xml version="1.0" encoding="UTF-8"?>
<!-- protocol/ae-shell-v1.xml
     Custom Wayland protocol for AnimusEngine / vitusOS AESurfaces.
     Third-party apps use xdg-shell. Native AESurfaces use this protocol.
     Allows global menu sync, Dock badge indicator, attention requests, and glass blur altitudes. -->

<protocol name="ae_shell_v1">
  <interface name="ae_shell_manager_v1" version="1">
    <description summary="AnimusEngine native shell integration manager"/>

    <request name="get_ae_surface">
      <description summary="Get AESurface for an xdg_toplevel"/>
      <arg name="id"       type="new_id" interface="ae_surface_v1"/>
      <arg name="toplevel" type="object" interface="xdg_toplevel"/>
    </request>
  </interface>

  <interface name="ae_surface_v1" version="1">
    <description summary="AnimusEngine surface integration"/>

    <!-- Sets the global menu bar content.
         Payload: UTF-8 JSON MenuDefinition -->
    <request name="set_application_menu">
      <arg name="menu_json" type="string"/>
    </request>

    <!-- Update single menu item state without full menu rebuild (Addendum F) -->
    <request name="update_menu_item">
      <arg name="item_path" type="string"/>  <!-- e.g. "File/Save" -->
      <arg name="enabled"   type="uint"/>    <!-- 0=disabled, 1=enabled -->
      <arg name="checked"   type="uint"/>    <!-- 0=unchecked, 1=checked, 2=N/A -->
    </request>

    <!-- Shadow rendering hint to compositor (Addendum F) -->
    <request name="set_shadow_style">
      <arg name="style" type="uint"/>
      <!-- 0=default (compositor chooses by altitude)
           1=none (suppress shadow for transparent windows)
           2=large (force floating-altitude shadow)  -->
    </request>

    <!-- Sets Dock badge count. -1 = remove badge. -->
    <request name="set_badge_count">
      <arg name="count" type="int"/>
    </request>

    <!-- Sets Surface Altitude for background glass blur rendering -->
    <request name="set_altitude">
      <arg name="altitude" type="uint"/>
    </request>

    <!-- Requests Dock icon bounce (e.g. background task complete) -->
    <request name="request_attention"/>

    <!-- Tell compositor this surface is no longer managed -->
    <request name="destroy" type="destructor"/>

    <!-- Compositor tells app: surface received keyboard focus -->
    <event name="focused"/>

    <!-- Compositor tells app: user clicked window close button -->
    <event name="close_requested"/>

    <!-- User activated a menu item (Addendum F: item_path, not menu_item_id) -->
    <event name="menu_activated">
      <arg name="item_path" type="string"/>  <!-- e.g. "File/Save" -->
    </event>

    <!-- Compositor reconfigures surface (size/state) -->
    <event name="configure">
      <arg name="width"  type="int"/>
      <arg name="height" type="int"/>
      <arg name="state"  type="uint"/>
    </event>
  </interface>
</protocol>
