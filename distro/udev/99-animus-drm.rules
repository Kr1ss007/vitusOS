# vitusOS AnimusEngine Direct Scanout and Hardware Access Rules

# Direct Rendering Manager (DRM) & Render Nodes
KERNEL=="card[0-9]*", SUBSYSTEM=="drm", GROUP="video", MODE="0660", TAG+="uaccess"
KERNEL=="renderD[0-9]*", SUBSYSTEM=="drm", GROUP="render", MODE="0666", TAG+="uaccess"

# NVIDIA Direct Devices
KERNEL=="nvidia*", GROUP="video", MODE="0660"
KERNEL=="nvidia-uvm*", GROUP="video", MODE="0666"
KERNEL=="nvidia-modeset*", GROUP="video", MODE="0660"

# DMA-BUF / dma_heap for zero-copy scanout
SUBSYSTEM=="dma_heap", GROUP="video", MODE="0660"

# KVM access for virtual machines
KERNEL=="kvm", GROUP="kvm", MODE="0666"
