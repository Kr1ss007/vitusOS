[Unit]
Description=vitusOS Top Panel & Global Menu Daemon
Documentation=https://github.com/Kr1ss007/vitusOS
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/vitusos-native --surface panel
Restart=always
RestartSec=1s

[Install]
WantedBy=vitusos-session.target
