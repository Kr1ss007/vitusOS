[Unit]
Description=vitusOS Dynamic Spring Dock Daemon
Documentation=https://github.com/Kr1ss007/vitusOS
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/vitusos-native --surface dock
Restart=always
RestartSec=1s

[Install]
WantedBy=vitusos-session.target
