#%PAM-1.0
# ==============================================================================
# vitusOS Canonical PAM Authentication Stack (LoginManager & Greeter)
# Supports Biometric Fingerprint (libfprint) + Argon2id / UNIX Passphrase
# ==============================================================================

# Authentication Stack
auth        [success=2 default=ignore] pam_fprintd.so max_tries=3 timeout=10
auth        [success=1 default=ignore] pam_unix.so nullok try_first_pass
auth        requisite                  pam_deny.so
auth        required                   pam_permit.so
auth        optional                   pam_gnome_keyring.so

# Account Verification
account     required                   pam_unix.so
account     required                   pam_nologin.so

# Password Management
password    sufficient                 pam_unix.so sha512 shadow nullok try_first_pass
password    required                   pam_deny.so

# Session Setup
session     required                   pam_env.so readenv=1 envfile=/etc/environment
session     required                   pam_limits.so
session     required                   pam_unix.so
session     optional                   pam_systemd.so
session     optional                   pam_gnome_keyring.so auto_start
